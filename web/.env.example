# Modelo para `.env.local` (sobrepõe o `.env` versionado com padrão local).
# JWT para cookie mw_session (mínimo 32 caracteres)
AUTH_SECRET=change-me-use-at-least-32-characters-long

# SQLite (default: data/app.db dentro de web/)
# DATABASE_PATH=data/app.db

# URL base do serviço Python (LangChain/LangGraph). Se vazio, o BFF usa modo stub.
ORCHESTRATION_API_URL=
# Opcional: Bearer para o serviço Python
ORCHESTRATION_API_KEY=
